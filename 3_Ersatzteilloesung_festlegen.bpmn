      <bpmndi:BPMNEdge id="E_2_di" bpmnElement="E_2">
        <di:waypoint x="340" y="150" />
        <di:waypoint x="395" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_Werkzeug_Nein_di" bpmnElement="E_Werkzeug_Nein">
        <di:waypoint x="445" y="150" />
