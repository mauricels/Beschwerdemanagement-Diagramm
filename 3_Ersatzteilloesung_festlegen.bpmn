<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Process_ErsatzteilloesungFestlegen" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:process id="Process_ErsatzteilloesungFestlegen" name="Ersatzteillösung festlegen" isExecutable="true">
    <bpmn:startEvent id="Start_E">
      <bpmn:outgoing>E_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Bestellen" name="Ersatzteil bestellen">
      <bpmn:incoming>E_1</bpmn:incoming>
      <bpmn:outgoing>E_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Werkzeug" name="Spezialwerkzeug für Einbau nötig?">
      <bpmn:incoming>E_2</bpmn:incoming>
      <bpmn:outgoing>E_Werkzeug_Nein</bpmn:outgoing>
      <bpmn:outgoing>E_Werkzeug_Ja</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Selbst" name="Selbsteinbau gewünscht?">
      <bpmn:incoming>E_Werkzeug_Nein</bpmn:incoming>
      <bpmn:outgoing>E_Selbst_Ja</bpmn:outgoing>
      <bpmn:outgoing>E_Selbst_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Selbst" name="Selbsteinbau durch Kunden">
      <bpmn:incoming>E_Selbst_Ja</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_JoinW">
      <bpmn:incoming>E_Werkzeug_Ja</bpmn:incoming>
      <bpmn:incoming>E_Selbst_Nein</bpmn:incoming>
      <bpmn:outgoing>E_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Werkstatt" name="Einbau durch Werkstatt">
      <bpmn:incoming>E_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="E_1" sourceRef="Start_E" targetRef="Task_Bestellen" />
    <bpmn:sequenceFlow id="E_2" sourceRef="Task_Bestellen" targetRef="GW_Werkzeug" />
    <bpmn:sequenceFlow id="E_Werkzeug_Nein" name="Nein" sourceRef="GW_Werkzeug" targetRef="GW_Selbst" />
    <bpmn:sequenceFlow id="E_Werkzeug_Ja" name="Ja" sourceRef="GW_Werkzeug" targetRef="GW_JoinW" />
    <bpmn:sequenceFlow id="E_Selbst_Ja" name="Ja" sourceRef="GW_Selbst" targetRef="End_Selbst" />
    <bpmn:sequenceFlow id="E_Selbst_Nein" name="Nein" sourceRef="GW_Selbst" targetRef="GW_JoinW" />
    <bpmn:sequenceFlow id="E_3" sourceRef="GW_JoinW" targetRef="End_Werkstatt" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_ErsatzteilloesungFestlegen">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_ErsatzteilloesungFestlegen" bpmnElement="Process_ErsatzteilloesungFestlegen">
