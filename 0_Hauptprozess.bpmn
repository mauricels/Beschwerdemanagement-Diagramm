<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Process_Beschwerdemanagement" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:collaboration id="Collaboration_Process_Beschwerdemanagement">
    <bpmn:participant id="Participant_Haendler" name="E-Bike-Händler" processRef="Process_Beschwerdemanagement" />
    <bpmn:participant id="Participant_Kunde" name="Kunde" />
    <bpmn:participant id="Participant_Hersteller" name="Hersteller" />
    <bpmn:participant id="Participant_Versicherung" name="Versicherung" />
    <bpmn:messageFlow id="Msg_Beschwerde" name="Beschwerde" sourceRef="Participant_Kunde" targetRef="Start_Beschwerde" />
    <bpmn:messageFlow id="Msg_KV" name="Kosten­voranschlag" sourceRef="Task_KV" targetRef="Participant_Kunde" />
    <bpmn:messageFlow id="Msg_Teil" name="Ersatzteil + Anleitung" sourceRef="Task_Versand" targetRef="Participant_Kunde" />
    <bpmn:messageFlow id="Msg_EBike" name="E-Bike + Rechnung" sourceRef="Task_Uebergabe" targetRef="Participant_Kunde" />
    <bpmn:messageFlow id="Msg_Antrag" name="Garantieantrag" sourceRef="Call_KostenuebernahmeKlaeren" targetRef="Participant_Hersteller" />
    <bpmn:messageFlow id="Msg_HEntscheid" name="Entscheidung" sourceRef="Participant_Hersteller" targetRef="Call_KostenuebernahmeKlaeren" />
    <bpmn:messageFlow id="Msg_Meldung" name="Schadens­meldung" sourceRef="Call_KostenuebernahmeKlaeren" targetRef="Participant_Versicherung" />
    <bpmn:messageFlow id="Msg_Erinnerung" name="Erinnerung" sourceRef="Call_KostenuebernahmeKlaeren" targetRef="Participant_Versicherung" />
    <bpmn:messageFlow id="Msg_VEntscheid" name="Entscheidung" sourceRef="Participant_Versicherung" targetRef="Call_KostenuebernahmeKlaeren" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Beschwerdemanagement" name="Beschwerdemanagement E-Bike" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Schadensmanagement" name="Schadensmanagement">
        <bpmn:flowNodeRef>Call_KostenuebernahmeKlaeren</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Werkstatt" name="Werkstatt">
        <bpmn:flowNodeRef>GW_JoinR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reparieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Uebergabe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Repariert</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kundenservice" name="Kundenservice">
        <bpmn:flowNodeRef>Start_Beschwerde</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Gedeckt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_KV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Schaden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Werkstatt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Versand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Versand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_FehlerKlaeren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_ErsatzteilloesungFestlegen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Aufnehmen</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Beschwerde" name="Beschwerde eingegangen">
      <bpmn:outgoing>M_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_Beschwerde_MED" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_Gedeckt" name="Kosten gedeckt?">
      <bpmn:incoming>M_04</bpmn:incoming>
      <bpmn:outgoing>M_Gedeckt_Nein</bpmn:outgoing>
      <bpmn:outgoing>M_Gedeckt_Ja</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_KV" name="Kostenvoranschlag senden">
      <bpmn:incoming>M_Gedeckt_Nein</bpmn:incoming>
      <bpmn:outgoing>M_05</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_KV" name="Kosten­voranschlag versendet">
      <bpmn:incoming>M_05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_Schaden" name="Höhe des Schadens?">
      <bpmn:incoming>M_Gedeckt_Ja</bpmn:incoming>
      <bpmn:outgoing>M_Schaden_Gering</bpmn:outgoing>
      <bpmn:outgoing>M_Schaden_Hoch</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Werkstatt" name="Einbau durch Werkstatt?">
      <bpmn:incoming>M_06</bpmn:incoming>
      <bpmn:outgoing>M_Werkstatt_Nein</bpmn:outgoing>
      <bpmn:outgoing>M_Werkstatt_Ja</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Versand" name="Ersatzteil mit Anleitung senden">
      <bpmn:incoming>M_Werkstatt_Nein</bpmn:incoming>
      <bpmn:outgoing>M_07</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Versand" name="Ersatzteil versendet">
      <bpmn:incoming>M_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_JoinR">
      <bpmn:incoming>M_Schaden_Hoch</bpmn:incoming>
      <bpmn:incoming>M_Werkstatt_Ja</bpmn:incoming>
      <bpmn:outgoing>M_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Reparieren" name="E-Bike reparieren">
      <bpmn:incoming>M_08</bpmn:incoming>
      <bpmn:outgoing>M_09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Task_Uebergabe" name="E-Bike übergeben und abrechnen">
      <bpmn:incoming>M_09</bpmn:incoming>
      <bpmn:outgoing>M_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Repariert" name="Reparatur abgeschlossen">
      <bpmn:incoming>M_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Call_FehlerKlaeren" name="Fehler klären" calledElement="Process_FehlerKlaeren">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Process_FehlerKlaeren" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>M_02</bpmn:incoming>
      <bpmn:outgoing>M_03</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_KostenuebernahmeKlaeren" name="Kostenübernahme klären" calledElement="Process_KostenuebernahmeKlaeren">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Process_KostenuebernahmeKlaeren" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>M_03</bpmn:incoming>
      <bpmn:outgoing>M_04</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_ErsatzteilloesungFestlegen" name="Ersatzteillösung festlegen" calledElement="Process_ErsatzteilloesungFestlegen">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Process_ErsatzteilloesungFestlegen" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>M_Schaden_Gering</bpmn:incoming>
      <bpmn:outgoing>M_06</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="M_01" sourceRef="Start_Beschwerde" targetRef="Task_Aufnehmen" />
    <bpmn:sequenceFlow id="M_02" sourceRef="Task_Aufnehmen" targetRef="Call_FehlerKlaeren" />
    <bpmn:sequenceFlow id="M_04" sourceRef="Call_KostenuebernahmeKlaeren" targetRef="GW_Gedeckt" />
    <bpmn:sequenceFlow id="M_Gedeckt_Nein" name="Nein" sourceRef="GW_Gedeckt" targetRef="Task_KV" />
    <bpmn:sequenceFlow id="M_Gedeckt_Ja" name="Ja" sourceRef="GW_Gedeckt" targetRef="GW_Schaden" />
    <bpmn:sequenceFlow id="M_05" sourceRef="Task_KV" targetRef="End_KV" />
    <bpmn:sequenceFlow id="M_Schaden_Gering" name="gering" sourceRef="GW_Schaden" targetRef="Call_ErsatzteilloesungFestlegen" />
    <bpmn:sequenceFlow id="M_Schaden_Hoch" name="hoch" sourceRef="GW_Schaden" targetRef="GW_JoinR" />
    <bpmn:sequenceFlow id="M_06" sourceRef="Call_ErsatzteilloesungFestlegen" targetRef="GW_Werkstatt" />
    <bpmn:sequenceFlow id="M_Werkstatt_Nein" name="Nein" sourceRef="GW_Werkstatt" targetRef="Task_Versand" />
    <bpmn:sequenceFlow id="M_Werkstatt_Ja" name="Ja" sourceRef="GW_Werkstatt" targetRef="GW_JoinR" />
    <bpmn:sequenceFlow id="M_07" sourceRef="Task_Versand" targetRef="End_Versand" />
    <bpmn:sequenceFlow id="M_08" sourceRef="GW_JoinR" targetRef="Task_Reparieren" />
    <bpmn:sequenceFlow id="M_09" sourceRef="Task_Reparieren" targetRef="Task_Uebergabe" />
    <bpmn:sequenceFlow id="M_10" sourceRef="Task_Uebergabe" targetRef="End_Repariert" />
    <bpmn:sequenceFlow id="M_03" sourceRef="Call_FehlerKlaeren" targetRef="Call_KostenuebernahmeKlaeren" />
    <bpmn:task id="Task_Aufnehmen" name="Beschwerde aufnehmen">
      <bpmn:incoming>M_01</bpmn:incoming>
      <bpmn:outgoing>M_02</bpmn:outgoing>
    </bpmn:task>
  </bpmn:process>
