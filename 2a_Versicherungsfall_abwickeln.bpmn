<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Process_VersicherungsfallAbwickeln" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:collaboration id="Collaboration_Process_VersicherungsfallAbwickeln">
    <bpmn:participant id="Participant_Haendler" name="E-Bike-Händler – Schadensmanagement" processRef="Process_VersicherungsfallAbwickeln" />
    <bpmn:participant id="Participant_Versicherung" name="Versicherung" />
    <bpmn:messageFlow id="Msg_Meldung" name="Schadens­meldung" sourceRef="Task_Melden" targetRef="Participant_Versicherung" />
    <bpmn:messageFlow id="Msg_VEntscheid" name="Entscheidung" sourceRef="Participant_Versicherung" targetRef="Task_Abwarten" />
    <bpmn:messageFlow id="Msg_Erinnerung" name="Erinnerung" sourceRef="Task_Nachfassen" targetRef="Participant_Versicherung" />
  </bpmn:collaboration>
  <bpmn:process id="Process_VersicherungsfallAbwickeln" name="Versicherungsfall abwickeln" isExecutable="true">
    <bpmn:startEvent id="Start_V">
      <bpmn:outgoing>V_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_VersPruefen" name="Schadens­ursache und Versicherung prüfen">
      <bpmn:incoming>V_1</bpmn:incoming>
      <bpmn:outgoing>V_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Versfall" name="Versicherungsfall?">
      <bpmn:incoming>V_2</bpmn:incoming>
      <bpmn:outgoing>V_Versfall_Ja</bpmn:outgoing>
      <bpmn:outgoing>V_Versfall_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Melden" name="Schaden an Versicherung melden">
      <bpmn:incoming>V_Versfall_Ja</bpmn:incoming>
      <bpmn:outgoing>V_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_Abwarten" name="Antwort der Versicherung abwarten">
      <bpmn:incoming>V_3</bpmn:incoming>
      <bpmn:outgoing>V_4</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="GW_Zusage" name="Deckungszusage erteilt?">
      <bpmn:incoming>V_4</bpmn:incoming>
      <bpmn:outgoing>V_Zusage_Ja</bpmn:outgoing>
      <bpmn:outgoing>V_Zusage_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Zusage" name="Deckungszusage erhalten">
      <bpmn:incoming>V_Zusage_Ja</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_JoinN">
      <bpmn:incoming>V_Versfall_Nein</bpmn:incoming>
      <bpmn:incoming>V_Zusage_Nein</bpmn:incoming>
      <bpmn:outgoing>V_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_KeineDeckung" name="Keine Deckung">
      <bpmn:incoming>V_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_Nachfassen" name="Bei Versicherung nochmal melden">
      <bpmn:incoming>V_6</bpmn:incoming>
      <bpmn:outgoing>V_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Erinnerung" name="Erinnerung versendet">
      <bpmn:incoming>V_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Timer_Erinnerung" name="alle 14 Tage" cancelActivity="false" attachedToRef="Task_Abwarten">
      <bpmn:outgoing>V_6</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Erinnerung_TED">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P14D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="V_1" sourceRef="Start_V" targetRef="Task_VersPruefen" />
    <bpmn:sequenceFlow id="V_2" sourceRef="Task_VersPruefen" targetRef="GW_Versfall" />
    <bpmn:sequenceFlow id="V_Versfall_Ja" name="Ja" sourceRef="GW_Versfall" targetRef="Task_Melden" />
    <bpmn:sequenceFlow id="V_Versfall_Nein" name="Nein" sourceRef="GW_Versfall" targetRef="GW_JoinN" />
    <bpmn:sequenceFlow id="V_3" sourceRef="Task_Melden" targetRef="Task_Abwarten" />
    <bpmn:sequenceFlow id="V_4" sourceRef="Task_Abwarten" targetRef="GW_Zusage" />
    <bpmn:sequenceFlow id="V_Zusage_Ja" name="Ja" sourceRef="GW_Zusage" targetRef="End_Zusage" />
    <bpmn:sequenceFlow id="V_Zusage_Nein" name="Nein" sourceRef="GW_Zusage" targetRef="GW_JoinN" />
    <bpmn:sequenceFlow id="V_5" sourceRef="GW_JoinN" targetRef="End_KeineDeckung" />
    <bpmn:sequenceFlow id="V_6" sourceRef="Timer_Erinnerung" targetRef="Task_Nachfassen" />
    <bpmn:sequenceFlow id="V_7" sourceRef="Task_Nachfassen" targetRef="End_Erinnerung" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_VersicherungsfallAbwickeln">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_VersicherungsfallAbwickeln" bpmnElement="Collaboration_Process_VersicherungsfallAbwickeln">
      <bpmndi:BPMNShape id="Participant_Haendler_di" bpmnElement="Participant_Haendler" isHorizontal="true">
        <dc:Bounds x="160" y="40" width="960" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_V_di" bpmnElement="Start_V">
