<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Process_KostenuebernahmeKlaeren" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.30.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:collaboration id="Collaboration_Process_KostenuebernahmeKlaeren">
    <bpmn:participant id="Participant_Haendler" name="E-Bike-Händler – Schadensmanagement" processRef="Process_KostenuebernahmeKlaeren" />
    <bpmn:participant id="Participant_Hersteller" name="Hersteller" />
    <bpmn:participant id="Participant_Versicherung" name="Versicherung" />
    <bpmn:messageFlow id="Msg_Antrag" name="Garantieantrag" sourceRef="Task_Antrag" targetRef="Participant_Hersteller" />
    <bpmn:messageFlow id="Msg_HEntscheid" name="Entscheidung" sourceRef="Participant_Hersteller" targetRef="Catch_Hersteller" />
    <bpmn:messageFlow id="Msg_Meldung" name="Schadens­meldung" sourceRef="Call_VersicherungsfallAbwickeln" targetRef="Participant_Versicherung" />
    <bpmn:messageFlow id="Msg_Erinnerung" name="Erinnerung" sourceRef="Call_VersicherungsfallAbwickeln" targetRef="Participant_Versicherung" />
    <bpmn:messageFlow id="Msg_VEntscheid" name="Entscheidung" sourceRef="Participant_Versicherung" targetRef="Call_VersicherungsfallAbwickeln" />
  </bpmn:collaboration>
  <bpmn:process id="Process_KostenuebernahmeKlaeren" name="Kostenübernahme klären" isExecutable="true">
    <bpmn:startEvent id="Start_K">
      <bpmn:outgoing>K_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_Garantie" name="Innerhalb Garantie?">
      <bpmn:incoming>K_1</bpmn:incoming>
      <bpmn:outgoing>K_Garantie_Ja</bpmn:outgoing>
      <bpmn:outgoing>K_Garantie_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Freigabe" name="Herstellerfreigabe erforderlich?">
      <bpmn:incoming>K_Garantie_Ja</bpmn:incoming>
      <bpmn:outgoing>K_Freigabe_Ja</bpmn:outgoing>
      <bpmn:outgoing>K_Freigabe_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Antrag" name="Garantieantrag an Hersteller senden">
      <bpmn:incoming>K_Freigabe_Ja</bpmn:incoming>
      <bpmn:outgoing>K_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Catch_Hersteller" name="Entscheidung Hersteller erhalten">
      <bpmn:incoming>K_2</bpmn:incoming>
      <bpmn:outgoing>K_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_Hersteller_MED" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="GW_Anerkannt" name="Garantie anerkannt?">
      <bpmn:incoming>K_3</bpmn:incoming>
      <bpmn:outgoing>K_Anerkannt_Ja</bpmn:outgoing>
      <bpmn:outgoing>K_Anerkannt_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_JoinG">
      <bpmn:incoming>K_Freigabe_Nein</bpmn:incoming>
      <bpmn:incoming>K_Anerkannt_Ja</bpmn:incoming>
      <bpmn:outgoing>K_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Garantie" name="Kosten durch Garantie gedeckt">
      <bpmn:incoming>K_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_JoinV">
      <bpmn:incoming>K_Garantie_Nein</bpmn:incoming>
      <bpmn:incoming>K_Anerkannt_Nein</bpmn:incoming>
      <bpmn:outgoing>K_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Deckung" name="Deckungszusage erhalten?">
      <bpmn:incoming>K_6</bpmn:incoming>
      <bpmn:outgoing>K_Deckung_Ja</bpmn:outgoing>
      <bpmn:outgoing>K_Deckung_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Versicherung" name="Kosten durch Versicherung gedeckt">
      <bpmn:incoming>K_Deckung_Ja</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Keine" name="Keine Kostenübernahme">
      <bpmn:incoming>K_Deckung_Nein</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Call_VersicherungsfallAbwickeln" name="Versicherungs­fall abwickeln" calledElement="Process_VersicherungsfallAbwickeln">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Process_VersicherungsfallAbwickeln" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>K_5</bpmn:incoming>
      <bpmn:outgoing>K_6</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="K_1" sourceRef="Start_K" targetRef="GW_Garantie" />
    <bpmn:sequenceFlow id="K_Garantie_Ja" name="Ja" sourceRef="GW_Garantie" targetRef="GW_Freigabe" />
    <bpmn:sequenceFlow id="K_Garantie_Nein" name="Nein" sourceRef="GW_Garantie" targetRef="GW_JoinV" />
    <bpmn:sequenceFlow id="K_Freigabe_Ja" name="Ja" sourceRef="GW_Freigabe" targetRef="Task_Antrag" />
    <bpmn:sequenceFlow id="K_Freigabe_Nein" name="Nein" sourceRef="GW_Freigabe" targetRef="GW_JoinG" />
    <bpmn:sequenceFlow id="K_2" sourceRef="Task_Antrag" targetRef="Catch_Hersteller" />
    <bpmn:sequenceFlow id="K_3" sourceRef="Catch_Hersteller" targetRef="GW_Anerkannt" />
    <bpmn:sequenceFlow id="K_Anerkannt_Ja" name="Ja" sourceRef="GW_Anerkannt" targetRef="GW_JoinG" />
    <bpmn:sequenceFlow id="K_Anerkannt_Nein" name="Nein" sourceRef="GW_Anerkannt" targetRef="GW_JoinV" />
    <bpmn:sequenceFlow id="K_4" sourceRef="GW_JoinG" targetRef="End_Garantie" />
    <bpmn:sequenceFlow id="K_5" sourceRef="GW_JoinV" targetRef="Call_VersicherungsfallAbwickeln" />
    <bpmn:sequenceFlow id="K_6" sourceRef="Call_VersicherungsfallAbwickeln" targetRef="GW_Deckung" />
    <bpmn:sequenceFlow id="K_Deckung_Ja" name="Ja" sourceRef="GW_Deckung" targetRef="End_Versicherung" />
    <bpmn:sequenceFlow id="K_Deckung_Nein" name="Nein" sourceRef="GW_Deckung" targetRef="End_Keine" />
  </bpmn:process>
